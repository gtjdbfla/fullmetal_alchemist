:8091 {
    redir /east /east/ 308
    redir /east/admin /east/admin/ 308
    handle_path /east/admin/* {
        root * /author
        file_server
    }
    handle_path /east/* {
        root * /srv
        file_server
    }
    handle {
        root * /srv
        file_server
    }
    @freshAssets not path /east/comics/*.webp /east/admin/comics/*.webp /comics/*.webp
    header @freshAssets Cache-Control "no-cache"
    @comicImages path /east/comics/*.webp /east/admin/comics/*.webp /comics/*.webp
    header @comicImages Cache-Control "public, max-age=31536000, immutable"
    encode gzip zstd
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
        # Versioned comic images keep their long-lived cache policy.

        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
    }
}
